{{define "page"}}<!doctype html>
<html lang="en" data-style="{{styleVersion}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} · GoAgentic</title>
<link rel="stylesheet" href="/style.css?v={{styleVersion}}">
</head>
<body>
<main id="main">{{template "main" .}}</main>
<script>
// Re-read the page every 5 seconds, as the TUI does, and swap in the new
// <main>. Paused while the tab is hidden, text is selected, or an answer is
// being written, so a refresh never eats a draft. Open <details> stay open.
// An empty chat box keeps refreshing, so replies show while you wait, and
// keeps its focus.
const main = document.getElementById("main");
let inflight = 0; // a post is waiting on the server: its form must stay
let dragging = null; // a sidebar row being dragged into a new place
// Screenshots waiting to go with the next message; they outlive refreshes.
let pending = [];
const busy = () => inflight || dragging || pending.length || document.hidden || String(getSelection()) || document.activeElement?.tagName === "SELECT" ||
  [...main.querySelectorAll("textarea")].some(t => t.value.trim() || (t === document.activeElement && !t.closest("form.send")));
// The chat follows new messages while you are at its bottom, and stays put
// while you read further up.
const chatState = () => {
  const c = document.getElementById("chat");
  return c && {top: c.scrollTop, bottom: c.scrollHeight - c.scrollTop - c.clientHeight < 40};
};
const chatRestore = st => {
  const c = document.getElementById("chat");
  if (c) c.scrollTop = !st || st.bottom ? c.scrollHeight : st.top;
};
chatRestore(null);
async function refresh(force) {
  const open = [...main.querySelectorAll("details[open]")].map(d => d.dataset.key);
  const res = await fetch(location.href, {headers: {"X-Partial": "1"}});
  if (!res.ok) return;
  const html = await res.text();
  if (!force && busy()) return; // started typing while it loaded
  const st = chatState(), typing = document.activeElement?.closest("form.send");
  // The sidebar and the panes keep where you had scrolled to.
  const scrolled = [...main.querySelectorAll("[data-scroll]")].map(el => [el.dataset.scroll, el.scrollTop]);
  // A new build brings a new stylesheet, which a swap would not load.
  const v = /data-style="([^"]*)"/.exec(html);
  if (v && v[1] !== document.documentElement.dataset.style) { location.reload(); return; }
  main.innerHTML = html;
  for (const [key, top] of scrolled) { const el = main.querySelector(`[data-scroll="${key}"]`); if (el) el.scrollTop = top; }
  if (typing) main.querySelector("form.send textarea")?.focus();
  for (const key of open) main.querySelector(`details[data-key="${CSS.escape(key)}"]`)?.setAttribute("open", "");
  chatRestore(st);
  restoreDraft();
  renderThumbs();
}
// Every 5 s, or every 1.5 s while an agent is starting, so its chat shows
// as soon as it is ready.
let ticks = 0;
setInterval(() => {
  ticks++;
  const due = main.querySelector(".loading") ? ticks % 3 === 0 : ticks % 10 === 0;
  if (due && !busy()) refresh().catch(() => {});
}, 500);
const frames = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏";
let frame = 0;
setInterval(() => {
  frame = (frame + 1) % frames.length;
  for (const s of main.querySelectorAll(".spin")) s.textContent = frames[frame];
}, 100);

// An answer or a chat message posts with the X-GoAgentic header (the server
// refuses writes without it), then the page refreshes to show it. A sent
// message shows in the chat once the agent's transcript has it.
main.addEventListener("submit", async e => {
  const form = e.target.closest("form.answer");
  if (!form) return;
  e.preventDefault();
  if (form.dataset.confirm && !confirm(form.dataset.confirm)) return;
  const button = e.submitter || form.querySelector("button[type=submit]"), status = form.querySelector(".status");
  button.disabled = true;
  status.classList.remove("error");
  status.textContent = form.classList.contains("start") ? "Starting…" : form.classList.contains("close") ? "Wrapping up…" : "Sending…";
  inflight++;
  try {
    const res = await fetch(form.action, {method: "POST", headers: {"X-GoAgentic": "1"}, body: sendBody(form, e.submitter)});
    if (!res.ok) throw new Error((await res.text()).trim() || res.statusText);
    const ta = form.querySelector("textarea");
    if (ta) ta.value = "";
    if (form.classList.contains("send")) { pending = []; renderThumbs(); clearDraft(form); }
    if (form.classList.contains("send")) document.getElementById("chat")?.scrollTo(0, 1e9);
    await refresh(true);
  } catch (err) {
    status.classList.add("error");
    status.textContent = err.message;
    button.disabled = false;
  } finally {
    inflight--;
  }
});
// The send box takes screenshots: dropped anywhere on the page, pasted into
// it, or picked with the clip. They show as thumbnails until sent.
const images = files => [...files].filter(f => /^image\/(png|jpeg|gif|webp)$/.test(f.type));
function addImages(files) {
  const add = images(files);
  if (!add.length || !main.querySelector("form.send")) return false;
  pending = pending.concat(add).slice(0, 6);
  renderThumbs();
  saveImages();
  main.querySelector("form.send textarea")?.focus();
  return true;
}
function renderThumbs() {
  const box = main.querySelector("form.send .thumbs");
  if (!box) return;
  for (const img of box.querySelectorAll("img")) URL.revokeObjectURL(img.src);
  box.replaceChildren(...pending.map((f, i) => {
    const t = document.createElement("span");
    t.className = "thumb";
    const img = document.createElement("img");
    img.src = URL.createObjectURL(f);
    img.alt = f.name || "screenshot";
    const x = document.createElement("button");
    x.type = "button";
    x.textContent = "×";
    x.title = "Remove";
    x.onclick = () => { pending.splice(i, 1); renderThumbs(); saveImages(); };
    t.append(img, x);
    return t;
  }));
}
// A message being written, and its screenshots, are kept per agent in the
// tab's session storage, so moving to another agent and back loses nothing.
const draftKey = () => { const f = main.querySelector("form.send"); return f && "draft:" + f.getAttribute("action"); };
function saveText() {
  const k = draftKey(), ta = main.querySelector("form.send textarea");
  if (!k || !ta) return;
  try { ta.value ? sessionStorage.setItem(k, ta.value) : sessionStorage.removeItem(k); } catch {}
}
async function saveImages() {
  const k = draftKey();
  if (!k) return;
  const urls = await Promise.all(pending.map(f => new Promise(ok => {
    const r = new FileReader();
    r.onload = () => ok({name: f.name, type: f.type, url: r.result});
    r.readAsDataURL(f);
  })));
  try { urls.length ? sessionStorage.setItem(k + ":images", JSON.stringify(urls)) : sessionStorage.removeItem(k + ":images"); } catch {}
}
let restoredFor = null;
async function restoreDraft() {
  const k = draftKey(), ta = main.querySelector("form.send textarea");
  if (!k || !ta) return;
  const text = sessionStorage.getItem(k);
  if (text && !ta.value) ta.value = text;
  if (restoredFor === k) return; // screenshots come back once per page
  restoredFor = k;
  const saved = JSON.parse(sessionStorage.getItem(k + ":images") || "[]");
  if (!saved.length || pending.length) return;
  pending = await Promise.all(saved.map(async s => new File([await (await fetch(s.url)).blob()], s.name || "screenshot.png", {type: s.type})));
  renderThumbs();
}
function clearDraft(form) {
  const k = "draft:" + form.getAttribute("action");
  try { sessionStorage.removeItem(k); sessionStorage.removeItem(k + ":images"); } catch {}
}
main.addEventListener("input", e => { if (e.target.matches?.("form.send textarea")) saveText(); });
restoreDraft();
function sendBody(form, submitter) {
  const data = new FormData(form);
  if (submitter?.name) data.set(submitter.name, submitter.value);
  data.delete("image");
  if (!form.classList.contains("send") || !pending.length) return new URLSearchParams(data);
  for (const f of pending) data.append("image", f, f.name || "screenshot.png");
  return data;
}
const hasFiles = e => [...(e.dataTransfer?.types || [])].includes("Files");
main.addEventListener("dragover", e => {
  if (!hasFiles(e) || !main.querySelector("form.send")) return;
  e.preventDefault();
  main.querySelector(".composer")?.classList.add("dropping");
});
main.addEventListener("dragleave", e => {
  if (!e.relatedTarget) main.querySelector(".composer")?.classList.remove("dropping");
});
main.addEventListener("drop", e => {
  if (!hasFiles(e)) return;
  main.querySelector(".composer")?.classList.remove("dropping");
  if (addImages(e.dataTransfer.files)) e.preventDefault();
});
main.addEventListener("paste", e => {
  if (e.target.matches?.("form.send textarea") && addImages(e.clipboardData?.files || [])) e.preventDefault();
});
main.addEventListener("change", e => {
  if (e.target.matches("form.send .attach input")) { addImages(e.target.files); e.target.value = ""; }
});
// Drag a workspace or an agent in the sidebar to reorder it; the order is
// saved on the server, so every browser shows it.
main.addEventListener("dragstart", e => {
  const li = e.target.closest?.(".sidebar li[data-name]");
  if (!li) return;
  dragging = li;
  li.classList.add("dragging");
  e.dataTransfer.effectAllowed = "move";
});
main.addEventListener("dragover", e => {
  const li = dragging && e.target.closest?.(".sidebar li[data-name]");
  if (!li || li.parentElement !== dragging.parentElement) return;
  e.preventDefault();
  if (li === dragging) return;
  const r = li.getBoundingClientRect();
  li.parentElement.insertBefore(dragging, e.clientY > r.top + r.height / 2 ? li.nextSibling : li);
});
main.addEventListener("drop", e => { if (dragging) e.preventDefault(); });
main.addEventListener("dragend", async () => {
  if (!dragging) return;
  const ul = dragging.parentElement;
  dragging.classList.remove("dragging");
  const body = new URLSearchParams({kind: ul.dataset.kind, ws: ul.dataset.ws || ""});
  for (const li of ul.querySelectorAll("li[data-name]")) body.append("name", li.dataset.name);
  inflight++;
  try {
    await fetch("/order", {method: "POST", headers: {"X-GoAgentic": "1"}, body});
  } finally {
    inflight--;
    dragging = null;
  }
  refresh(true).catch(() => {});
});
main.addEventListener("keydown", e => {
  if (e.key === "Enter" && (e.metaKey || e.ctrlKey) && e.target.matches("form.answer textarea")) e.target.form.requestSubmit();
});
</script>
</body>
</html>{{end}}

{{define "main"}}
<div class="app{{if .Agent}} agent-view{{end}}{{if .Team}} agent-view team-view{{end}}" data-style="{{styleVersion}}">
<header class="topbar">
  <button class="menu" type="button" aria-label="Show the sidebar" onclick="document.body.classList.toggle('nav-open')">☰</button>
  <span class="brand">{{with .Nav}}{{.Current}}{{end}}</span>
  <span class="topbar-right">{{if .All}}<a href="?">hide retired</a>{{else}}<a href="?all=1">show retired</a>{{end}} · {{.Scanned.Format "15:04:05"}}</span>
</header>
<nav class="sidebar" data-scroll="sidebar">{{with .Nav}}
  <h4 title="Drag to reorder">Workspaces</h4>
  <ul data-kind="workspaces">{{range .Workspaces}}{{template "navlink" .}}{{end}}</ul>
  {{with .Teams}}<h4>Teams</h4>
  <ul class="teams">{{range .}}{{template "teamlink" .}}{{end}}</ul>{{end}}
  <h4 title="Drag to reorder">Agents</h4>
  <ul data-kind="agents" data-ws="{{.Current}}">{{range .Agents}}{{template "navlink" .}}{{end}}</ul>
{{end}}</nav>
<section class="content" data-scroll="content">
{{if .Counts}}{{template "counts" .}}{{end}}
{{if .Workspace}}{{template "workspace" .}}{{end}}
{{if .Agent}}{{template "agent" .}}{{end}}
{{with .Team}}{{template "team" .}}{{end}}
{{with .File}}<h2>{{.Name}}</h2><pre class="file">{{.Text}}</pre>{{end}}
</section>
</div>
{{end}}

{{define "counts"}}{{$c := .Counts}}
<header class="counts">
  <h1>{{.Heading}}</h1>
  <ul>
    {{if .Live}}<li class="{{if $c.Live}}ok{{else}}dim{{end}}">● {{$c.Live}} running</li>{{end}}
    <li class="{{if $c.ForYou}}foryou{{else}}dim{{end}}">✋ {{$c.ForYou}} waiting on you</li>
    <li class="{{if $c.Overdue}}blocked{{else}}dim{{end}}">⚑ {{$c.Overdue}} overdue</li>
    <li class="{{if $c.Waiting}}waiting{{else}}dim{{end}}">◆ {{$c.Waiting}} P1 waiting on others</li>
    <li class="{{if $c.Blocked}}blocked{{else}}dim{{end}}">■ {{$c.Blocked}} blocked</li>
    <li class="{{if not $c.Health}}dim{{end}}">⚠ {{$c.Health}} health</li>
    {{with $.Workspace}}{{if .Over}}<li class="blocked" title="Running sessions past the context budget: wrap them">◕ {{.Over}} past context budget</li>{{end}}{{if .Soon}}<li class="waiting" title="Running sessions nearing the context budget">◑ {{.Soon}} near context budget</li>{{end}}{{end}}
  </ul>
</header>
{{end}}

{{define "state"}}<span class="state {{.Class}}">{{if .Working}}<span class="spin" aria-hidden="true">⠋</span> {{end}}{{with .Activity}}{{template "activity" .}}{{else}}{{.State}}{{end}}</span>{{end}}

{{define "activity"}}<span class="activity">{{.Word}}</span>{{with .Meta}} <span class="dim">{{.}}</span>{{end}}{{end}}

{{define "navlink"}}<li data-name="{{.Name}}"><a class="{{if .Current}}current{{else if .Selected}}selected{{end}}{{if .Bold}} bold{{end}}" href="{{.Href}}"{{if .State}} title="{{.State}}"{{end}}><span class="dot {{if .Dot}}{{.Dot}}{{else}}off{{end}}"></span><span class="nm">{{.Name}}{{with .Sub}}<small>{{.}}</small>{{end}}</span>{{if or .Badge .Others}}<span class="badge split" title="{{.Badge}} waiting on you · {{.Others}} P1 waiting on others"><span class="you{{if not .Badge}} zero{{end}}">{{.Badge}}</span><span class="others{{if not .Others}} zero{{end}}">{{.Others}}</span></span>{{end}}</a></li>{{end}}

{{define "teamlink"}}<li><a class="{{if .Current}}current{{end}}" href="{{.Href}}"><span class="dot {{if .Dot}}{{.Dot}}{{else}}off{{end}}"></span><span class="nm">{{.Name}} team<small>{{.Sub}}</small></span>{{if .Badge}}<span class="badge" title="{{.Badge}} waiting on you">{{.Badge}}</span>{{end}}</a></li>{{end}}

{{define "queue"}}
<section class="card card-{{.Class}}{{if not .Total}} quiet{{end}}"><h2 class="card-head"><span class="cdot"></span>{{.Title}}{{if .Total}}<span class="pill">{{.Total}}</span>{{end}}</h2>
{{if .Top}}<ul class="items queue">{{range .Top}}{{template "qline" .}}{{end}}</ul>
{{with .More}}<details class="more-queue" data-key="{{$.Key}}-more"><summary class="dim">{{len .}} more</summary><ul class="items queue">{{range .}}{{template "qline" .}}{{end}}</ul></details>{{end}}
{{else}}<p class="dim none">{{.Empty}}</p>{{end}}
</section>
{{end}}

{{define "qline"}}<li><span class="who"><a href="{{.AgentHref}}">{{.Agent}}</a></span> {{if .Item}}{{template "item" .Item}}{{with .Tag}} <span class="tag {{$.TagClass}}">{{.}}</span>{{end}}{{else}}<span>{{.Text}}</span>{{end}}</li>{{end}}

{{define "legend"}}
<p class="legend dim"><span class="dot blocked"></span> blocked <span class="dot waiting"></span> P1 waiting on others <span class="dot foryou"></span> waiting on you <span class="dot working"></span> working · no dot: nothing to act on</p>
{{end}}

{{define "workspace"}}
{{with .Workspace}}
{{with .Teams}}<h2>Teams</h2>
<div class="agent-cards">{{range .}}<a class="acard tcard" href="{{.Href}}">
  <div class="ahead"><span class="dot {{.Dot}}"></span><span class="nm"><b>{{.Lead}} team</b><small>{{with .Title}}{{.}} · {{end}}{{plural .Members "member"}}</small></span>{{if .Counts.NeedsYou}}<span class="badge" title="{{.Counts.NeedsYou}} waiting on you">{{.Counts.NeedsYou}}</span>{{end}}</div>
  <div class="facts"><span class="{{if .Counts.Working}}ok{{end}}">{{.Counts.Working}} working</span> · <span class="{{if .Counts.Questions}}waiting{{end}}">{{.Counts.Questions}} questions</span> · {{.Counts.Review}} in review · {{.Counts.DoneToday}} done today</div>
  {{range .On}}<p class="on">{{.}}</p>{{else}}<p class="on dim">Nothing in flight.</p>{{end}}
</a>{{end}}</div>{{end}}
<h2>Agents</h2>
<div class="agent-cards">
{{range .Rows}}<a class="acard{{with .Now}}{{if .Working}} busy{{end}}{{end}}" href="{{.Href}}">
  <div class="ahead"><span class="dot {{.Tone}}"></span><span class="nm"><b>{{.Agent}}</b>{{with .Title}}<small>{{.}}</small>{{end}}</span>{{if or .OnYou .OnOthers}}<span class="badge split" title="{{.OnYou}} waiting on you · {{.OnOthers}} P1 waiting on others"><span class="you{{if not .OnYou}} zero{{end}}">{{.OnYou}}</span><span class="others{{if not .OnOthers}} zero{{end}}">{{.OnOthers}}</span></span>{{end}}</div>
  {{with .Now}}{{if .Working}}<p class="working-band"><span class="pulse" aria-hidden="true"></span>Working{{with .Activity}} · {{.Word}}{{with .Meta}} <span class="meta">{{.}}</span>{{end}}{{end}}</p>{{end}}{{end}}
  <div class="facts">{{with .Now}}{{if .Working}}<span class="ok">working</span>{{else}}{{template "state" .}}{{end}}{{else}}<span class="{{.LiveClass}}">{{.Live}}</span>{{end}} · <span class="dim">{{.Harness}}</span>{{if ne .Started "—"}} · <span class="dim">started {{.Started}} ago</span>{{end}} · <span class="health-{{.Level}}" title="Health">{{.Health}}</span></div>
  {{with .Ctx}}<p class="actx {{.Tone}}" title="{{.Hint}}"><span class="bar"><span style="width: {{.Pct}}%"></span><i style="left: {{.Budget}}%"></i></span>{{.Text}}</p>{{end}}
  {{with .Now}}{{with .Last}}<p class="last">“{{.}}”</p>{{end}}{{end}}
  {{if .Next}}<p class="next"><span class="dim">Next</span> {{trimPlan .Next}}{{if .NextBlocked}} <span class="blocked">■ blocked</span>{{else if .NextWaiting}} <span class="{{if .NextP1}}waiting{{else}}dim{{end}}">◆ waiting</span>{{end}}</p>{{end}}
</a>{{end}}
</div>
{{end}}
{{template "legend"}}
{{if .Queue}}<div class="cards">{{template "queue" .Queue}}{{template "queue" .Others}}{{template "queue" .Overdue}}</div>{{end}}
{{end}}

{{define "item"}}<details class="item{{if .Answers}} answered{{end}}" data-key="{{.Key}}">
<summary><span class="pri">{{.Priority}}</span> <span class="id">#{{trimHash .ID}}</span> <span class="ht"><span class="headline">{{.Headline}}</span>{{if .Note}} <span class="dim">{{.Note}}</span>{{end}}{{if .Desc}}<span class="desc">{{.Desc}}</span>{{end}}</span>{{if or .Late .Due .Answers .Reply .CanAnswer}}<span class="tags">{{if .Late}}<span class="blocked tag">⚑ overdue</span>{{else if .Due}}<span class="dim tag">due {{.Due.Format "Mon 02 Jan"}}</span>{{end}}{{if .Answers}}<span class="ok tag">✓ answered, waiting on {{.Agent}}</span>{{else if .Reply}}<span class="answer-hint reply">Reply</span>{{else if .CanAnswer}}<span class="answer-hint">Answer</span>{{end}}</span>{{end}}</summary>
<div class="more">
  {{if .Step}}<p><span class="dim">{{.StepLabel}}</span> {{.Step}}</p>{{end}}
  {{if .Detail}}<p>{{.Detail}}</p>{{end}}
  <p class="dim">{{if .Owner}}Owner {{.Owner}}{{end}}{{if .Status}} · {{.Status}}{{end}}{{if .Due}} · due {{.Due.Format "2006-01-02"}}{{end}}</p>
  {{if .History}}<p><a href="{{.History}}">History note →</a></p>{{end}}
  {{range .Answers}}<blockquote class="given"><span class="dim">You, {{.At.Format "Mon 15:04"}}:</span> {{.Text}}</blockquote>{{end}}
  {{if .Answers}}<p class="dim">{{.Agent}} picks this up at its next start{{if .AgentLive}}. It is running now, so it will not see this until it restarts; reply in its chat to reach it now{{end}}.</p>{{end}}
  {{if .Reply}}<form class="answer reply" method="post" action="{{.SendURL}}">
    <input type="hidden" name="id" value="{{trimHash .ID}}">
    <textarea name="text" rows="3" maxlength="4000" placeholder="Your update for {{.Agent}}" aria-label="Update on #{{trimHash .ID}}"></textarea>
    <div class="row"><button type="submit" name="ask" value="more" class="quiet" formnovalidate>More info</button> <button type="submit">Provide update</button> <span class="dim hint">{{.Agent}} is running: More info asks it “#{{trimHash .ID}}?”; an update is typed in as “Update on #{{trimHash .ID}}: …” · ⌘/Ctrl-Enter</span> <span class="status"></span></div>
  </form>{{else if .CanAnswer}}<form class="answer" method="post" action="{{.AnswerURL}}">
    <input type="hidden" name="id" value="{{trimHash .ID}}">
    <textarea name="text" rows="3" maxlength="4000" placeholder="{{if .Answers}}Add to your answer{{else}}Your answer to {{.Agent}}{{end}}" aria-label="Answer #{{trimHash .ID}}"></textarea>
    <div class="row"><button type="submit">Send answer</button> <span class="dim hint">Goes to {{.Agent}}'s inbox; it reads it at its next start · ⌘/Ctrl-Enter</span> <span class="status"></span></div>
  </form>{{end}}
</div>
</details>{{end}}

{{define "section"}}{{/* . is a list of webItem */}}{{if .}}<ul class="items">{{range .}}<li>{{template "item" .}}</li>{{end}}</ul>{{else}}<p class="dim none">None</p>{{end}}{{end}}

{{define "agent"}}
{{with .Agent}}
<header class="agent-head">
  <span class="avatar" style="--hue: {{.Hue}}" aria-hidden="true">{{.Initial}}</span>
  <div class="who-block">
    <div class="name-row"><h1 class="agent-name">{{.Name}}</h1>
    <span class="status-pill {{.StateClass}}">{{if or (eq .State "working") (eq .State "starting") (eq .State "wrapping up")}}<span class="spin" aria-hidden="true">⠋</span>{{else}}<span class="sdot"></span>{{end}}{{.State}}</span></div>
    {{with .Title}}<p class="agent-title">{{.}}</p>{{end}}
    <p class="agent-meta">{{with .Head}}<span class="runs" title="{{.ModelHint}}">{{.Mark}}{{.Model}}</span>{{with .When}}<span class="when">{{.}}</span>{{end}}{{end}}</p>
  </div>
  <div class="head-side">
    {{with .Head}}{{with .Ctx}}<span class="chip ctx {{.Tone}}" title="{{.Hint}}"><span class="bar"><span style="width: {{.Pct}}%"></span><i style="left: {{.Budget}}%"></i></span>{{.Text}}</span>{{end}}{{end}}
    {{if and .CloseURL (not .WrapStopped) (not .Wrapping)}}<form class="answer close" method="post" action="{{.CloseURL}}">
      <span class="status{{if .CloseError}} error{{end}}">{{.CloseError}}</span> <button type="submit" class="{{if and .Head.Ctx .Head.Ctx.Over}}nudge{{else}}quiet{{end}}"{{if .Busy}} disabled title="{{.Name}} is busy — wrap when it has finished"{{else}} title="Runs its wrap, then closes the pane"{{end}}>Wrap &amp; close</button>
    </form>{{end}}
  </div>
</header>
<div class="agent-split">
<div class="info" data-scroll="info">{{template "tracker" .}}</div>
<div class="chat-col">{{template "session" .}}</div>
</div>
{{end}}
{{end}}

{{define "tracker"}}{{$href := .SessionHref}}
<div class="info-cards">
{{with .Focus}}<section class="card card-focus"><h3 class="card-head"><span class="cdot"></span>Session priorities<span class="agreed{{if not .Agreed}} pending{{end}}">{{if .Agreed}}agreed {{else}}proposed {{end}}{{.At.Local.Format "15:04"}}</span></h3>
<ul class="items">{{range .Items}}<li>{{with .Ref}}{{template "item" .}}{{else}}{{template "steprow" (stepArgs "" .Lead .Text)}}{{end}}</li>{{end}}</ul>{{if not .Agreed}}<p class="dim sub">Waiting for you to agree in the chat.</p>{{end}}</section>{{end}}
{{if not .Focus}}<section class="card card-plan{{if not .Plan}} quiet{{end}}"><h3 class="card-head"><span class="cdot"></span>{{if .ChatLive}}Plan from its last wrap{{else}}Next session{{end}}</h3>
{{if and .ChatLive .Plan}}<p class="dim sub">Set at its last wrap; the session beside may have moved on.</p>{{end}}{{template "plan" .Plan}}</section>{{end}}
<section class="card card-foryou{{if not (or .Mine .Answered)}} quiet{{end}}"><h3 class="card-head"><span class="cdot"></span>Waiting on you{{with .Mine}}<span class="pill">{{len .}}</span>{{end}}</h3>
{{if or .Mine .Answered}}<ul class="items">{{range .Mine}}<li>{{template "item" .}}</li>{{end}}{{range .Answered}}<li>{{template "item" .}}</li>{{end}}</ul>{{else}}<p class="dim none">Nothing waiting on you.</p>{{end}}
</section>



{{if .Others}}<section class="card card-waiting"><h3 class="card-head"><span class="cdot"></span>Waiting on others<span class="pill">{{len .Others}}</span></h3>{{template "section" .Others}}</section>{{end}}
{{if .Blocked}}<section class="card card-blocked"><h3 class="card-head"><span class="cdot"></span>Blocked<span class="pill">{{len .Blocked}}</span></h3>{{template "section" .Blocked}}</section>{{end}}
<section class="card card-open{{if not .Open}} quiet{{end}}"><h3 class="card-head"><span class="cdot"></span>Open actions<span class="pri-counts">P1 {{index .OpenCounts "P1"}}  P2 {{index .OpenCounts "P2"}}  P3 {{index .OpenCounts "P3"}}</span></h3>{{template "section" .Open}}</section>
<section class="card card-sched{{if .SchedMissed}} missed{{else if not (or .Scheduled .Inbox)}} quiet{{end}}"><h3 class="card-head"><span class="cdot"></span>Scheduled{{with .Scheduled}}<span class="pill">{{len .}}</span>{{end}}</h3>
{{if .Scheduled}}<ul class="tasks">{{range .Scheduled}}<li{{if .Off}} class="off"{{end}}><span class="task">{{.ID}}</span> <span class="dim">{{.When}}</span> <span class="runs">{{if .Missed}}<span class="blocked">⚑ {{.Missed}}</span> · {{end}}<span class="dim">{{.Last}} · {{.Next}}</span></span></li>{{end}}</ul>{{else}}<p class="dim none">No scheduled tasks.</p>{{end}}
{{if .Inbox}}<p class="inbox-note">{{plural .Inbox "run"}} not yet read: start {{.Name}} to drain its inbox</p>{{end}}</section>

<footer class="info-foot">
{{if .Parked}}<details data-key="parked"><summary>{{len .Parked}} parked</summary>{{template "section" .Parked}}</details>{{end}}
{{with .Head.Reviewed}}<p>Tracker reviewed {{.}}</p>{{end}}
{{with .LastSession}}<p>Last session {{if not .Date.IsZero}}{{.Date.Format "Mon 02 Jan"}}: {{end}}<a href="{{$href}}">{{.Title}}</a></p>{{end}}
{{if .Health.Findings}}<p class="health-{{.Health.Level}}">Health {{.Health.Level.Symbol}}</p><ul>{{range .Health.Findings}}<li>{{.}}</li>{{end}}</ul>
{{else}}<p>Health <span class="ok">✓</span> {{.HealthLine}}</p>{{end}}
</footer>
</div>
{{end}}

{{define "plan"}}{{if .}}<ul class="items">{{range .}}<li>{{with .Ref}}{{template "item" .}}{{else}}{{template "steprow" (stepArgs .Priority .Text "")}}{{end}}</li>{{end}}</ul>{{else}}<p class="dim none">None</p>{{end}}{{end}}

{{define "steprow"}}<div class="item steprow"><span class="pri">{{.Priority}}</span> <span class="id"></span> <span class="ht"><span class="headline">{{.Text}}</span>{{if .Desc}}<span class="desc">{{.Desc}}</span>{{end}}</span></div>{{end}}

{{define "session"}}
{{if .Loading}}<div class="loading" role="status"><span class="spin" aria-hidden="true">⠋</span> <strong>{{.LoadingText}}</strong>{{with .Activity}} {{template "activity" .}}{{end}}
<p class="dim">Opening its pane and loading its context. The conversation starts here once {{.Name}} is ready.</p></div>
{{else if .Prompt}}<p class="ended"><strong>{{.Name}} is waiting on a prompt in its pane</strong> (a folder-trust question, say). Answer it there; the conversation starts here after.</p>
{{else if .ChatLive}}{{if .Wrapping}}<div class="loading wrapping" role="status"><span class="spin" aria-hidden="true">⠋</span> <strong>Wrapping up {{.Name}}…</strong> <span class="dim">It records the session, then its pane closes.</span></div>
{{else if .WrapStopped}}<p class="ended"><strong>{{.Name}} stopped before its wrap finished</strong> (no session log written). Read its last message below; answer it, or close anyway.</p>
{{end}}<div class="chat" id="chat">
{{if .ChatNote}}<p class="dim">{{.ChatNote}}</p>{{end}}
{{range .Chat}}{{if eq .Kind "you"}}<div class="msg you"><div class="bubble">{{.Text}}{{with .Images}}<span class="shots">{{range .}}<a href="{{.}}" target="_blank"><img src="{{.}}" alt="screenshot" loading="lazy"></a>{{end}}</span>{{end}}</div><time>{{.At.Local.Format "15:04"}}</time></div>
{{else if eq .Kind "agent"}}<div class="msg agent"><div class="bubble">{{.HTML}}</div><time>{{.At.Local.Format "15:04"}}</time></div>
{{else}}<details class="tools" data-key="tools-{{.At.UnixNano}}"><summary>⚙ {{.Summary}}</summary><ul>{{range .Tools}}<li>{{.}}</li>{{end}}</ul></details>
{{end}}{{end}}
{{with .Activity}}<p class="msg working" role="status"><span class="spin" aria-hidden="true">⠋</span> {{template "activity" .}}</p>{{end}}
</div>
{{else}}<p class="ended"><strong>Not running</strong>{{if not .LastEnded.IsZero}} · last session ended {{.LastEnded.Local.Format "Mon 15:04"}}{{end}}{{with .SessionHref}} (<a href="{{.}}">log →</a>){{end}}</p>
{{end}}{{if or .Loading .Prompt .Wrapping}}{{else if .CanSend}}<div class="composer"><form class="answer send" method="post" action="{{.SendURL}}">
  <textarea name="text" rows="2" maxlength="4000" placeholder="Message {{.Name}} — drop or paste screenshots" aria-label="Message {{.Name}}"></textarea>
  <div class="thumbs"></div>
  <div class="row"><button type="submit">Send</button> <label class="attach" title="Add screenshots">📎<input type="file" accept="image/png,image/jpeg,image/gif,image/webp" multiple hidden></label> <span class="dim hint">⌘/Ctrl-Enter · typed into its session; images go as file paths</span> <span class="status"></span></div>
</form></div>{{else if .CanStart}}<form class="answer start" method="post" action="{{.StartURL}}">
  <div class="row"><button type="submit">Start {{.Name}}</button> <span class="dim hint">Opens it in {{.StartsIn}} ({{.Harness}}) and runs its start; your view stays put.</span> <span class="status{{if .StartError}} error{{end}}">{{.StartError}}</span></div>
</form>{{else}}<p class="dim send-note">{{.SendNote}}</p>{{end}}
{{if and .WrapStopped .CloseURL}}<form class="answer close" method="post" action="{{.CloseURL}}" data-confirm="Close {{.Name}}'s pane without a finished wrap? Anything it has not recorded is lost.">
  <input type="hidden" name="force" value="1">
  <div class="row"><button type="submit" class="danger">Close anyway</button> <span class="status{{if .CloseError}} error{{end}}">{{.CloseError}}</span></div>
</form>{{end}}
{{end}}

{{define "team"}}
<header class="agent-head team-head">
  <span class="avatar" style="--hue: {{.Hue}}" aria-hidden="true">{{.Initial}}</span>
  <div class="who-block">
    <div class="name-row"><h1 class="agent-name">{{.Lead}} team</h1>
    <span class="status-pill {{if .Counts.Working}}ok{{end}}">{{if .Counts.Working}}<span class="spin" aria-hidden="true">⠋</span>{{plural .Counts.Working "order"}} in progress{{else}}<span class="sdot"></span>quiet{{end}}</span></div>
    <p class="agent-title">Led by <a href="{{.LeadHref}}">{{.Lead}}</a>{{with .LeadTitle}} · {{.}}{{end}} · {{plural .Members "member"}} · watch only</p>
  </div>
  <div class="head-side team-counts">
    <span class="chip{{if .Counts.Working}} on-ok{{end}}"><b>{{.Counts.Working}}</b> working</span>
    <span class="chip{{if .Counts.Questions}} on-waiting{{end}}"><b>{{.Counts.Questions}}</b> questions</span>
    <span class="chip{{if .Counts.Review}} on-accent{{end}}"><b>{{.Counts.Review}}</b> in review</span>
    <span class="chip"><b>{{.Counts.DoneToday}}</b> done today</span>
  </div>
</header>
<div class="agent-split team-split">
<div class="info" data-scroll="info">
{{with .NeedsYou}}<section class="card card-foryou"><h3 class="card-head"><span class="cdot"></span>Needs you<span class="pill">{{len .}}</span></h3>
<ul class="orders">{{range .}}{{template "order" .}}{{end}}</ul>
<p class="dim sub">Past its due time, at the round limit, or waiting on you. The lead brings these to you; answer it in the lead's chat.</p></section>{{end}}
<div class="live-strip">{{range .Live}}<a class="mcard{{if .Lead}} lead{{end}}{{if .Working}} busy{{else if .Off}} off{{end}}" href="{{.Href}}">
  <div class="mhead"><span class="avatar sm" style="--hue: {{.Hue}}" aria-hidden="true">{{.Initial}}</span><span class="nm"><b>{{.Name}}</b><small>{{if .Lead}}Lead{{else}}{{.Title}}{{end}}</small></span>
  <span class="status-pill {{.Class}}">{{if .Working}}<span class="spin" aria-hidden="true">⠋</span>{{else}}<span class="sdot"></span>{{end}}{{with .Activity}}<span class="activity">{{.Word}}</span>{{else}}{{.State}}{{end}}</span></div>
  {{if .Working}}<p class="working-band"><span class="pulse" aria-hidden="true"></span>Working {{.Where}}{{with .Activity}}{{with .Meta}} · {{.}}{{end}}{{end}}</p>{{else if .Where}}<p class="where dim">Idle {{.Where}}</p>{{end}}
  {{with .Order}}<p class="on"><span class="wo">{{.No}}</span> {{.Title}}</p>
  <p class="ometa"><span class="ostatus s-{{.Status}}">{{.Status}}</span> · {{.Elapsed}}{{if .Timebox}} of {{dur .Timebox}}{{end}}{{if .Rounds}} · round {{.Rounds}}{{end}}{{with .Flag}} · <span class="blocked">{{.}}</span>{{end}}</p>
  {{if .Timebox}}<span class="tbar{{if ge .Used 100}} over{{end}}"><span style="width: {{.Used}}%"></span></span>{{end}}
  {{else}}{{if not .Lead}}<p class="on dim">No work order in flight.</p>{{end}}{{end}}
  {{with .Last}}<p class="said"><time>{{.At.Local.Format "Mon 15:04"}}</time> {{.Text}}</p>{{end}}
</a>{{end}}</div>
<h2 class="team-h">Work orders</h2>
<div class="lanes">{{range .Lanes}}<section class="card lane lane-{{.Class}}{{if not .Orders}} quiet{{end}}"><h3 class="card-head"><span class="cdot"></span>{{.Title}}{{with .Orders}}<span class="pill">{{len .}}</span>{{end}}</h3>
{{if .Orders}}<ul class="orders">{{range .Orders}}{{template "order" .}}{{end}}</ul>{{else}}<p class="dim none">{{.Empty}}</p>{{end}}{{with .Note}}<p class="dim sub">{{.}}</p>{{end}}</section>{{end}}</div>
<h2 class="team-h">Outcomes</h2>
<div class="outcomes">{{range .Outcomes}}<section class="card outcome"><h3 class="card-head"><span class="cdot"></span><a href="{{.Href}}">{{.Title}}</a>{{with .Orders}}<span class="pill">{{len .}} in flight</span>{{end}}</h3>
{{with .Next}}<p class="onext"><span class="dim">Where it stands</span>{{.}}</p>{{end}}
{{with .Orders}}<ul class="ochips">{{range .}}<li><a href="{{.Href}}">{{.No}} {{.Member}}</a> <span class="ostatus s-{{.Status}}">{{.Status}}</span></li>{{end}}</ul>{{end}}
<p class="dim sub">{{with .Approved}}Approved {{.}} · {{end}}{{plural .Done "work order"}} done{{with .Plan}} · {{plural (len .) "plan step"}}{{end}}</p>
</section>{{else}}<p class="dim">No active outcomes.</p>{{end}}</div>
{{with .Closed}}<details class="closed" data-key="closed-outcomes"><summary class="dim">{{plural (len .) "closed outcome"}}</summary><ul class="closed-list">{{range .}}<li><a href="{{.Href}}">{{.Title}}</a> <span class="dim">· {{plural .Done "work order"}}</span></li>{{end}}</ul></details>{{end}}
</div>
<div class="chat-col"><section class="card feed"><h3 class="card-head"><span class="cdot"></span>Activity<span class="feed-note">newest first · every 5 s</span></h3>
<div class="feed-scroll" data-scroll="feed">{{range .Feed}}<h4 class="feed-day">{{.Day}}</h4>
<ol class="feed-list">{{range .Lines}}<li class="{{.Kind}}{{if .Lead}} by-lead{{end}}"><time>{{if .NoClock}}–{{else}}{{.At.Local.Format "15:04"}}{{end}}</time><div class="fbody">{{if .Who}}<span class="fwho" style="--hue: {{.Hue}}">{{.Who}}</span> {{end}}<span class="ftext">{{.Text}}</span>{{if .No}} <a class="fref" href="{{.Href}}">{{.No}}</a>{{end}}</div></li>{{end}}</ol>{{else}}<p class="dim none">No work orders yet.</p>{{end}}</div>
</section></div>
</div>
{{end}}

{{define "order"}}<li><div class="oline"><a href="{{.Href}}"><span class="wo">{{.No}}</span> <b>{{.Member}}</b></a>{{with .Flag}} <span class="tag blocked">{{.}}</span>{{end}}{{if .Stopped}} <span class="tag dim">stopped</span>{{end}}{{with .Elapsed}} <span class="dim tag">{{.}}</span>{{end}}</div>
<div class="otitle">{{.Title}}</div>{{with .Last}}<div class="olast"><time>{{.At.Local.Format "15:04"}}</time> {{if .Who}}{{.Who}}: {{end}}{{.Text}}</div>{{end}}</li>{{end}}
