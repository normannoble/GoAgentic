    <label>Status<select name="state">{{range .States}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select></label>
    <label>Waiting on<input name="who" value="{{.Who}}" placeholder="who"></label>
    {{if .HasPriority}}<label>Priority<select name="priority">{{range .Priorities}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select></label>{{end}}
    {{if .HasDue}}<label>Due<input name="due" value="{{.Due}}"></label>{{end}}
    <label>Owner<input name="owner" value="{{.Owner}}"></label>
    <label class="wide">Note<textarea name="note" rows="3">{{.Note}}</textarea></label>
  </div>
  <div class="tk-btns"><button type="button" data-cancel>Cancel</button><button type="submit" class="primary">Save to tracker</button></div>
</form>{{end}}

{{define "tasks-action"}}<div class="tk-action">
  <p><span class="tk-live {{.Class}}"></span><span><b>{{.Agent}}</b> is {{.State}}. {{plural .Pending "answer"}} waiting to be applied.</span></p>
  {{if .Tell}}<form class="tk-post" method="post" action="{{.SendURL}}" data-next="{{.Next}}" data-busy="Telling {{.Agent}}…"><input type="hidden" name="text" value="{{.Text}}"><button type="submit" class="primary">Tell {{.Agent}}</button></form>
  {{else if .Start}}<form class="tk-post" method="post" action="{{.StartURL}}" data-next="{{.Next}}" data-busy="Starting {{.Agent}}…"><button type="submit" class="primary">Start {{.Agent}} to apply</button></form>{{with .Starts}}<small>Opens in {{.}}.</small>{{end}}
  {{else}}{{with .Note}}<small>{{.}}</small>{{end}}{{end}}
</div>{{end}}

{{define "tasks-sweep"}}{{$sv := .}}
{{if .Empty}}<div class="tk-clear"><p class="big">All clear.</p><p>{{.Empty}}</p></div>
{{else if .End}}<div class="tk-clear done"><p class="big">Done.</p><p>You went through {{plural .Total "item"}}.</p></div>
