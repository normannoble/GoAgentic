  </article>
  {{with .Edit}}<details class="tk-panel" id="do"><summary class="tk-sr">Change</summary>{{template "tasks-do" (doArgs . $sv.EditNext)}}</details>{{end}}
  {{with $sv.Merge}}<details class="tk-panel" id="merge"><summary class="tk-sr">Merge</summary><form class="tk-post tk-merge" method="post" action="/tasks/answer" data-next="{{$sv.MergeNext}}" data-undo data-busy="Sending…">
    <input type="hidden" name="ws" value="{{$sv.Row.WS}}"><input type="hidden" name="agent" value="{{$sv.Row.Agent}}"><input type="hidden" name="id" value="{{trimID $sv.Row.ID}}">
    <p class="tk-pophead">Merge #{{trimID $sv.Row.ID}} into…</p><ul>{{range .}}<li><button type="submit" name="text" value="{{.Value}}">{{.Label}}</button></li>{{end}}</ul></form></details>{{end}}
  <form class="tk-post" id="decide" method="post" action="/tasks/answer" data-next="{{$sv.AnswerNext}}" data-undo data-busy="Sending…">
    <input type="hidden" name="ws" value="{{.WS}}"><input type="hidden" name="agent" value="{{.Agent}}"><input type="hidden" name="id" value="{{trimID .ID}}">
  </form>
  <form class="tk-post" id="doneform" method="post" action="/tasks/done" data-next="{{$sv.DoneNext}}" data-undo data-busy="Moving to Completed…">
    <input type="hidden" name="ws" value="{{.WS}}"><input type="hidden" name="agent" value="{{.Agent}}"><input type="hidden" name="id" value="{{trimID .ID}}"><input type="hidden" name="hash" value="{{$sv.Hash}}">
  </form>
  {{end}}{{end}}
  {{with .UndoID}}<form class="tk-post" id="undoform" method="post" action="/tasks/undo" data-next="{{$sv.UndoNext}}" data-busy="Undoing…"><input type="hidden" name="id" value="{{.}}"></form>{{end}}
  <div class="tk-dock">
    {{with .Row}}<div>  <form class="tk-post tk-instruct" method="post" action="/tasks/answer" data-next="{{$sv.AnswerNext}}" data-undo data-busy="Sending…">
    <input type="hidden" name="ws" value="{{.WS}}"><input type="hidden" name="agent" value="{{.Agent}}"><input type="hidden" name="id" value="{{trimID .ID}}">
    <div class="tk-qchips">
      <button type="button" data-fill="Do it.">Do it</button><button type="button" data-fill="Close it.">Close it</button><button type="button" data-fill="Park it till Monday.">Park till Mon</button><button type="button" data-fill="Ask me again on Friday.">Ask me Fri</button>
      {{with $sv.Others}}<details class="tk-pop tk-hand"><summary>Hand to…</summary><div class="tk-popbody"><p class="tk-pophead">Hand it to</p><ul>{{range .}}<li><button type="button" data-fill="Hand this to {{.}}.">{{.}}</button></li>{{end}}</ul></div></details>{{end}}
    </div>
    <div class="tk-ibox"><textarea name="text" rows="1" placeholder="Tell {{.Agent}} what to do…" aria-label="Instruction for {{.Agent}}"></textarea>
      <button type="submit" class="tk-sendbtn" aria-label="Send"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"/></svg></button></div>
  </form>
</div>{{end}}
    <div id="tk-decide" data-poll>{{with .Row}}{{if or .Rec .Mine}}<div class="tk-decide">
      <button type="submit" form="decide" name="text" value="No." data-key="n">No</button>
      {{if .Rec}}<button type="submit" form="decide" name="text" value="Yes, as recommended." class="primary" data-key="y">Yes, as recommended</button>{{else}}<button type="submit" form="decide" name="text" value="Yes." class="primary" data-key="y">Yes</button>{{end}}
    </div>{{end}}{{end}}</div>
    <div class="tk-nav">
      {{if .BackHref}}<a class="tk-arrow" href="{{.BackHref}}" data-key="back" aria-label="Back"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></a>{{else}}<span class="tk-arrow off"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></span>{{end}}
      {{if .Row}}<button type="submit" form="doneform" data-key="d" title="Done (d)">Done</button>{{if .Merge}}<button type="button" data-open="merge">Merge</button>{{end}}{{if .Row.Edit}}<button type="button" data-open="do">Change</button>{{end}}{{end}}
      {{if .UndoID}}<button type="submit" form="undoform" data-key="u" title="Undo (u)">Undo</button>{{end}}
      <a class="tk-skip" href="{{if .Row}}{{.SkipNext}}{{else}}{{.Next}}{{end}}" data-key="next">{{if .Row}}Skip{{else}}Next{{end}}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></a>
    </div>
  </div>
{{end}}{{end}}

{{define "tasks-do"}}<form class="tk-post tk-form" method="post" action="/tasks/edit" data-next="{{.Next}}">
  {{with .Edit}}<input type="hidden" name="ws" value="{{.WS}}"><input type="hidden" name="agent" value="{{.Agent}}"><input type="hidden" name="id" value="{{.ID}}"><input type="hidden" name="hash" value="{{.Hash}}"><input type="hidden" name="back" value="{{$.Next}}"><input type="hidden" name="state" value="{{.State}}">
  <div class="tk-seg">
    <button type="submit" name="state" value="In progress">In progress</button>
    <button type="submit" name="state" value="Not started">Not started</button>
    <button type="submit" name="state" value="Parked">Parked</button>
    <button type="submit" name="state" value="Waiting on">Waiting on…</button>
  </div>
  <div class="tk-fields">
    <label>Waiting on<input name="who" value="{{.Who}}" placeholder="who, for Waiting on…"></label>
    {{if .HasPriority}}<label>Priority<select name="priority">{{range .Priorities}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select></label>{{end}}
    {{if .HasDue}}<label>Due<input name="due" value="{{.Due}}"></label>{{end}}
    <label class="wide">Note<textarea name="note" rows="3">{{.Note}}</textarea></label>
  </div>
  <div class="tk-btns"><button type="button" data-cancel>Cancel</button><button type="submit" class="primary">Save</button></div>{{end}}
</form>{{end}}

{{define "tasks-legend"}}<ul class="tk-legend" aria-label="What the dots mean">
  <li><span class="tk-dot me"></span>Waiting on you</li>
  <li><span class="tk-dot answered"></span>Answered, not yet applied</li>
  <li><span class="tk-dot progress"></span>In progress</li>
  <li><span class="tk-dot waiting"></span>Waiting on others</li>
  <li><span class="tk-dot todo"></span>Not started</li>
  <li><span class="tk-dot parked"></span>Parked</li>
</ul>{{end}}

{{define "tasks-tile"}}<span class="tk-tile {{.Class}}">{{if .Avatar}}<img class="tk-av img {{.Class}}" src="{{.Avatar}}" alt="" aria-hidden="true">{{else}}<span class="tk-av {{.Class}}" style="--h: {{hue .Name}}" aria-hidden="true">{{initial .Name}}</span>{{end}}{{with .Live}}<i class="tk-presence {{.}}" title="{{if eq . "off"}}Not running{{else}}Live · {{.}}{{end}}"></i>{{end}}</span>{{end}}

{{define "tasks-theme"}}<div class="tk-theme" role="group" aria-label="Theme">
  <a href="/tasks/theme?{{themeQuery "light" .Here}}" role="button" data-theme-pick="light" aria-label="Light" title="Light" aria-pressed="{{eq .Theme "light"}}"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></a>
  <a href="/tasks/theme?{{themeQuery "dark" .Here}}" role="button" data-theme-pick="dark" aria-label="Dark" title="Dark" aria-pressed="{{eq .Theme "dark"}}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg></a>
  <a href="/tasks/theme?{{themeQuery "system" .Here}}" role="button" data-theme-pick="system" aria-label="System" title="System" aria-pressed="{{eq .Theme "system"}}"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg></a>
</div>{{end}}

{{define "tasks-pane"}}<aside class="tk-pane" id="tk-pane" aria-label="Details"><div class="tk-resize" role="separator" aria-orientation="vertical" aria-label="Resize the panel" tabindex="0" title="Drag to resize; double-click to reset"></div>{{with .Detail}}
<div class="tk-phead">
  <span class="tk-ptag">Task</span>
  <a class="tk-pclose" href="{{.Close}}" data-pane-close aria-label="Close">×</a>
</div>
{{template "tasks-taskbody" .}}
{{end}}</aside>{{end}}

{{define "tasks-chat"}}<div class="tk-chat" id="tk-chat">
{{if .Live}}<div class="tk-chatlog" id="tk-chatlog">{{range .Entries}}{{if eq .Kind "you"}}<div class="tk-msg you"><div class="tk-bubble">{{with .Images}}<span class="tk-shots">{{range .}}<a class="tk-img" href="{{.}}"><img src="{{.}}" alt="Attached image" loading="lazy"></a>{{end}}</span>{{end}}{{.Text}}</div><time>{{.At.Local.Format "15:04"}}</time></div>
{{else if eq .Kind "agent"}}<div class="tk-msg agent"><div class="tk-text">{{.HTML}}</div><time>{{.At.Local.Format "15:04"}}</time></div>
{{else}}<details class="tk-steps"><summary>{{.Summary}}</summary><ul>{{range .Tools}}<li>{{.}}</li>{{end}}</ul></details>{{end}}{{else}}<p class="tk-muted">Nothing said yet in this session.</p>{{end}}{{if eq .State "working"}}<div class="tk-typing" role="status"><span class="tk-dots"><i></i><i></i><i></i></span>{{.Agent}} is working…</div>{{end}}</div>
{{with .Note}}<p class="tk-muted">{{.}}</p>{{end}}
{{if .CanSend}}<form class="tk-composer" data-compose method="post" action="{{.SendURL}}" enctype="multipart/form-data">
  <div class="tk-thumbs" aria-live="polite"></div>
  <textarea name="text" rows="1" placeholder="Message {{.Agent}}…" aria-label="Message {{.Agent}}"></textarea>
  <div class="tk-cbar">
    <label class="tk-attach" title="Attach an image"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5l-8.2 8.2a5 5 0 0 1-7.1-7.1l8.5-8.5a3.3 3.3 0 0 1 4.7 4.7l-8.5 8.5a1.7 1.7 0 0 1-2.4-2.4l7.8-7.8"/></svg><span class="tk-sr">Attach an image</span><input type="file" accept="image/png,image/jpeg,image/gif,image/webp" multiple hidden></label>
    <span class="tk-cstatus" role="status"></span>
    <button type="submit" class="tk-sendbtn" aria-label="Send" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"/></svg></button>
  </div>
</form>{{end}}
{{else if .Starting}}<div class="tk-pempty"><p>Starting {{.Agent}}…</p></div>
{{else}}<div class="tk-pempty"><p><b>{{.Agent}}</b> is not running.</p>
{{if .Start}}<form class="tk-post" method="post" action="{{.StartURL}}" data-next="{{.Next}}" data-busy="Starting {{.Agent}}…"><button type="submit" class="primary">Start {{.Agent}}</button></form>{{with .Starts}}<small>Opens in {{.}}.</small>{{end}}{{end}}
{{with .Note}}<small>{{.}}</small>{{end}}</div>{{end}}
</div>{{end}}

{{define "tasks-taskbody"}}{{$d := .}}{{with .Row}}<div class="tk-pbody">
  <p class="tk-pmeta">{{template "tasks-tile" (tile .Agent .Avatar "sm")}}<span class="tk-who">{{.Agent}}</span><span>{{.WS}}</span><span class="tk-id">#{{trimID .ID}}</span></p>
  <h2 class="tk-ptitle">{{.Headline}}</h2>
  {{with .Desc}}<p class="tk-pdesc">{{.}}</p>{{end}}
  {{with .Edit}}<form class="tk-post tk-props" id="pedit" method="post" action="/tasks/edit" data-next="{{.Back}}">
    <input type="hidden" name="ws" value="{{.WS}}"><input type="hidden" name="agent" value="{{.Agent}}"><input type="hidden" name="id" value="{{.ID}}"><input type="hidden" name="hash" value="{{.Hash}}"><input type="hidden" name="back" value="{{.Back}}">
    <div class="tk-prop"><span>Agent</span><span class="v">{{$d.Row.Agent}}</span></div>
    <div class="tk-prop"><span>Workspace</span><span class="v">{{$d.Row.WS}}</span></div>
    <div class="tk-prop"><label for="p-state">Status</label><span class="v tk-pair"><span class="tk-dot {{$d.Row.Dot}}" aria-hidden="true"></span><select id="p-state" name="state">{{range .States}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select><input name="who" value="{{.Who}}" placeholder="who" aria-label="Waiting on"></span></div>
    {{if .HasPriority}}<div class="tk-prop"><label for="p-pri">Priority</label><span class="v"><select id="p-pri" name="priority">{{range .Priorities}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select></span></div>{{end}}
    {{if .HasDue}}<div class="tk-prop"><label for="p-due">Due</label><span class="v"><input id="p-due" name="due" value="{{.Due}}" placeholder="Empty"{{if $d.Row.Late}} class="late"{{end}}></span></div>{{end}}
    <div class="tk-prop"><label for="p-owner">Owner</label><span class="v"><input id="p-owner" name="owner" value="{{.Owner}}" placeholder="Empty"></span></div>
    {{with $d.Since}}<div class="tk-prop"><span>Since</span><span class="v">{{.}}</span></div>{{end}}
  </form>{{end}}
  {{template "tasks-ask" .}}
  {{if or .Rec .Mine}}<form class="tk-post tk-decide-inline" method="post" action="/tasks/answer" data-next="{{.Back}}" data-busy="Sending…">
    <input type="hidden" name="ws" value="{{.WS}}"><input type="hidden" name="agent" value="{{.Agent}}"><input type="hidden" name="id" value="{{trimID .ID}}">{{if .ToChat}}<input type="hidden" name="to" value="chat">{{end}}
    <button type="submit" name="text" value="No.">No</button>{{if .Rec}}<button type="submit" name="text" value="Yes, as recommended." class="primary">Yes, as recommended</button>{{else}}<button type="submit" name="text" value="Yes." class="primary">Yes</button>{{end}}
  </form>{{end}}
  <section class="tk-preply"><h3>Reply</h3>{{template "tasks-reply" (replyArgs . .Back)}}</section>
  {{with .Edit}}<section class="tk-pmore"><h3><label for="p-note">Status note</label></h3><textarea id="p-note" name="note" rows="4" form="pedit">{{.Note}}</textarea></section>{{end}}
  {{with .Detail}}<section class="tk-pmore"><h3>More</h3><p>{{.}}</p></section>{{end}}
</div>
{{if .Edit}}<footer class="tk-pfoot"><span>{{.StateText}}</span><button type="button" data-cancel-pane>Cancel</button><button type="submit" form="pedit" class="primary">Save</button></footer>{{end}}
{{else}}<div class="tk-pempty"><p>Select a task to see it here.</p></div>{{end}}{{end}}

{{define "tasks-top"}}<header class="tk-top">
  <a class="tk-mark" href="/tasks" title="GoAgentic Tasks"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="6.5" class="m-bg"/><circle cx="8.5" cy="9" r="2.2" class="m-fg"/><path d="M12.5 9h4M7 15.5l2.2 2.2 4.3-4.3M15.5 16h1.5" class="m-ln"/></svg><span class="tk-sr">GoAgentic Tasks</span></a>
  <details class="tk-pop tk-space"><summary>{{.Nav.SpaceLabel}}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></summary>
    <div class="tk-popbody"><p class="tk-pophead">Space</p><ul>{{range .Nav.Spaces}}<li><a href="{{.Href}}"{{if .Current}} class="current" aria-current="true"{{end}}>{{.Label}}</a></li>{{end}}</ul></div></details>
  <form class="tk-search" method="get" action="/tasks/search" role="search">
    {{with .Nav.Space}}<input type="hidden" name="ws" value="{{.}}">{{end}}
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4 4"/></svg>
    <input type="search" name="q" value="{{with .Search}}{{.Q}}{{end}}" placeholder="Search tasks and agents" aria-label="Search tasks and agents" autocomplete="off" spellcheck="false">
    <kbd class="tk-kbd">⌘K</kbd>
    <div class="tk-results" role="listbox" hidden></div>
  </form>
  <a class="tk-iconbtn tk-searchicon" href="/tasks/search{{with .Nav.Space}}?ws={{.}}{{end}}" aria-label="Search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4 4"/></svg></a>
  <div class="tk-topright">
    <details class="tk-pop tk-livepop"><summary title="Agents running now"><i class="tk-presence {{if .Nav.Live}}idle{{else}}off{{end}}"></i>{{len .Nav.Live}} live</summary>
      <div class="tk-popbody right"><p class="tk-pophead">Running now</p>{{if .Nav.Live}}<ul>{{range .Nav.Live}}<li><a href="{{.Href}}">{{template "tasks-tile" (tile .Label .Avatar "xs" .Live)}}<span>{{.Label}}</span><small>{{.Live}}</small></a></li>{{end}}</ul>{{else}}<p class="tk-muted">No agent is running.</p>{{end}}</div></details>
    <div class="tk-toptheme">{{template "tasks-theme" .}}</div>
    <details class="tk-pop tk-more"><summary aria-label="More"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.3"/><circle cx="12" cy="12" r="1.3"/><circle cx="19" cy="12" r="1.3"/></svg></summary>
      <div class="tk-popbody right">
        <div class="tk-moretheme">{{template "tasks-theme" .}}</div>
        <ul class="tk-morenav">{{range .Nav.Views}}<li><a href="{{.Href}}"{{if .Current}} class="current"{{end}}><span>{{.Label}}</span>{{if .Count}}<span class="tk-n">{{.Count}}</span>{{end}}</a></li>{{end}}
        {{range .Nav.Workspaces}}{{range .Agents}}<li><a href="{{.Href}}"{{if .Current}} class="current"{{end}}>{{template "tasks-tile" (tile .Label .Avatar "xs" .Live)}}<span>{{.Label}}</span>{{if .Count}}<span class="tk-n you">{{.Count}}</span>{{end}}</a></li>{{end}}{{end}}</ul>
        <ul><li><a href="/">Classic view</a></li></ul>
      </div></details>
  </div>
</header>{{end}}

{{define "tasks-search"}}{{if .Hits}}<ul class="tk-hits">{{range .Hits}}<li><a href="{{.Href}}">{{if eq .Kind "agent"}}{{template "tasks-tile" (tile .Title .Avatar "sm")}}{{else}}<span class="tk-dot {{.Dot}}" aria-hidden="true"></span>{{end}}<span class="tk-hittext"><b>{{.Title}}</b><small>{{if eq .Kind "item"}}{{.Agent}} · {{end}}{{.Sub}}</small></span></a></li>{{end}}</ul>
{{else if .Q}}<div class="tk-clear"><p class="big">Nothing found.</p><p>Try another word.</p></div>
{{else}}<p class="tk-muted">Type in the search box above.</p>{{end}}{{end}}
