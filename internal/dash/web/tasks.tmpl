    {{else}}<p>{{.Have}} of {{.Of}} have a recommendation.</p>{{end}}
    {{if .CanSend}}{{if not .Prepping}}<form class="tk-post" method="post" action="{{.SendURL}}" data-next="{{.Next}}" data-busy="Asking {{.Agent}}…"><input type="hidden" name="text" value="{{.Text}}"><button type="submit" class="tk-btn primary">Prep</button></form>{{end}}
    {{else if .CanStart}}<form class="tk-post" method="post" action="{{.StartURL}}" data-next="{{$.Next}}" data-busy="Starting {{.Agent}}…"><button type="submit" class="tk-btn">Start {{.Agent}} to prep</button></form>
